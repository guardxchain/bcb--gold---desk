//@version=6
// BCB Desk Price Feed - sends every closed 1-minute gold candle to the BCB Gold Desk.
// Put it on an XAUUSD 1-minute chart, then create ONE alert:
//   Condition: "BCB Desk Price Feed" -> "Any alert() function call"
//   Webhook URL: https://<your-railway-address>/tick
indicator("BCB Desk Price Feed", overlay = true)

deskSecret = input.string("", "Desk webhook secret")

if barstate.isconfirmed
    msg = '{"secret":"' + deskSecret + '","symbol":"XAUUSD"' +
          ',"price":' + str.tostring(close) +
          ',"high":' + str.tostring(high) +
          ',"low":' + str.tostring(low) +
          ',"time":"' + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '"}'
    alert(msg, alert.freq_once_per_bar_close)
